# ResuMatch - environment variables
#
# Copy this file to `.env` (git-ignored) and fill in real values.
#   PowerShell:  Copy-Item .env.example .env
# Never commit `.env`, and never paste real secrets into an issue, a screenshot or a chat.
#
# Local Tomcat: Tomcat runs from $CATALINA_HOME\bin, so point it at this file explicitly:
#   PowerShell:  $env:RESUMATCH_ENV_FILE = "C:\path\to\resumatch\.env"
# In Eclipse:  Run > Run Configurations > Arguments > VM arguments
#              -DRESUMATCH_ENV_FILE=C:\path\to\resumatch\.env   (or -Dresumatch.env.file=...)
#              The -D form works too: ConfigLoader checks env var, then both -D spellings.
#              (or use the Environment tab of the run configuration)

# ---------- Database (required) ----------
# Local MySQL 8.0. Create the schema and a dedicated user first (see README).
DB_URL=jdbc:mysql://localhost:3306/resumatch?characterEncoding=utf8&allowPublicKeyRetrieval=true&useSSL=false
DB_USER=resumatch_app
DB_PASSWORD=change-me

# Test database used by DAO/integration tests (never the development schema).
TEST_DB_URL=jdbc:mysql://localhost:3306/resumatch_test?characterEncoding=utf8&allowPublicKeyRetrieval=true&useSSL=false
# DAO/integration tests read these (or -Dtest.db.url / -Dtest.db.user / -Dtest.db.password).
TEST_DB_USER=resumatch_app
TEST_DB_PASSWORD=change-me

# Aiven in production looks like this (SSL required, non-default port):
# DB_URL=jdbc:mysql://mysql-xxxx.aivencloud.com:12345/defaultdb?sslMode=REQUIRED&characterEncoding=utf8

# Pool size: keep it small, Aiven's free plan allows only about 76 connections in total.
DB_POOL_MAX=5

# ---------- Server ----------
# Render sets PORT itself. Tomcat locally always uses 8080.
PORT=8080
APP_ENV=local
APP_NAME=ResuMatch

# Used only by the optional CORS filter, which is off by default.
FRONTEND_ORIGIN=http://localhost:8080

# ---------- Admin seed (required from Phase 1) ----------
# The admin account is created on first start if it does not exist.
ADMIN_EMAIL=shudanshubora1410@gmail.com
ADMIN_PASSWORD=change-me-too

# ---------- Support / branding ----------
SUPPORT_EMAIL=support.resumatch@gmail.com

# ---------- File storage: disk | db ----------
# disk = local development. db = production (Render's disk is ephemeral).
FILE_STORAGE=disk
FILE_STORAGE_DIR=uploads

# ---------- Email ----------
# smtp = Gmail with an App Password (local). brevo = HTTPS API (production). 
MAIL_PROVIDER=smtp
MAIL_FROM=support.resumatch@gmail.com
MAIL_FROM_NAME=ResuMatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support.resumatch@gmail.com
# Gmail App Password (16 characters, no spaces) - not your normal Google password.
SMTP_PASSWORD=
BREVO_API_KEY=

# ---------- Google sign-in ----------
# Authorised JavaScript origins: http://localhost:8080 and your Vercel URL.
GOOGLE_CLIENT_ID=

# ---------- AI providers (keys stay on the server, never in the browser) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
