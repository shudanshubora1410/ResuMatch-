# Normalise line endings so the same repo works on Windows and inside Linux containers.
* text=auto
*.sh   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.java text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
Dockerfile text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
